[user]
    name = nabezokodaikon
    email = nabezoko.daikon@gmail.com
[core]
    editor = "code" --wait
    ; 改行コードを自動変換しない。
    autocrlf = false
    ; Gitで日本語ファイル名を表示する。
    quotepath = false
[push]
    ; upstreamが設定されていて、それが同名のブランチ名であるときのみpushする。
    default = simple
[http]
    ; リモートリポジトリが自己証明書の場合は接続しない。
    sslVerify = true
[diff]
    ; diffの前後行数を変更。
    context = 8
[credential]
    ; 認証ファイルを指定。
    helper = store --file ~/.git-credentials
[init]
    ; デフォルトのブランチ名。
    defaultBranch = main
[safe]
    directory = *
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
